{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "make run",
            "problemMatcher": []
        },
        {
            "label": "run-debug",
            "type": "shell",
            "command": "make run-debug",
            "problemMatcher": []
        },
        {
            "label": "Clean, build and run everything",
            "dependsOn": ["clean", "build", "run"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "options": {
                // requires the Tasks extension
                "statusbar": {
                    "label": "$(play) Run"
                }
            }
        },
        {
            "label": "Clean, build and debug",
            "dependsOn": ["clean", "build", "run-debug"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "label": "$(play) Debug"
                }
            }
        }
    ]
}